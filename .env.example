# SupportFlow - Configuration Docker
# Copier ce fichier vers .env et personnaliser les valeurs

# ==============================================
# BASE DE DONNÉES
# ==============================================
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=supportflow
MYSQL_PASSWORD=supportflow123

# ==============================================
# KEYCLOAK
# ==============================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Client secret for the confidential "supportflow-backend" client (keycloak/supportflow-realm.json).
# Override this for any non-local deployment - the default below is a known, committed value.
KEYCLOAK_BACKEND_CLIENT_SECRET=supportflow-backend-secret

# ==============================================
# JWT
# ==============================================
JWT_SECRET=SupportFlowSecretKey2024VeryLongSecretKeyForJWTTokenGeneration

# ==============================================
# SPRING PROFILES
# ==============================================
SPRING_PROFILES_ACTIVE=docker
SUPPORTFLOW_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ==============================================
# BACKEND RESSOURCES
# ==============================================
# Spring Boot + Camunda a besoin d'une marge memoire au demarrage.
BACKEND_MEMORY_LIMIT=1536m
BACKEND_MEMORY_RESERVATION=768m
BACKEND_JAVA_INITIAL_RAM_PERCENTAGE=20.0
BACKEND_JAVA_MAX_RAM_PERCENTAGE=65.0
MYSQL_MEMORY_LIMIT=1g
MYSQL_MEMORY_RESERVATION=512m
